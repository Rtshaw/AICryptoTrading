# ---- Postgres ----
POSTGRES_USER=cryptotrading
POSTGRES_PASSWORD=cryptotrading
POSTGRES_DB=cryptotrading
DATABASE_URL=postgres://cryptotrading:cryptotrading@localhost:55532/cryptotrading?sslmode=disable

# ---- Backend server ----
# Chosen to avoid clashing with other local projects' common ports (8080)
# and with the sibling TWSEDailyTrading project's own 8180.
SERVER_PORT=8280
# Optional: set to require `X-API-Key` header on all /api requests. Leave empty to disable (single-user local tool).
API_KEY=

# ---- Binance USDS-M Futures ----
# Create keys at https://www.binance.com/en/my/settings/api-management with
# Futures trading enabled. THIS IS YOUR REAL MAINNET ACCOUNT - the backend
# places real orders (sized to MARGIN_USD fixed margin per order, notional =
# MARGIN_USD * LEVERAGE_DEFAULT - see below, no separate notional ceiling)
# the moment it starts, if ANTHROPIC_API_KEY is also set (see
# AUTOTRADE_ENABLED_DEFAULT below and the kill switch in the dashboard).
# IP-whitelisting the key is recommended.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_REST_BASE_URL=https://fapi.binance.com
# If some network (firewall/VPN/antivirus) between you and Binance completes
# the WSS handshake but silently drops data frames afterward, the backend
# still works correctly via its REST-polling fallback (internal/marketdata
# PollCandles/PollFunding, internal/autotrader SyncAccountState/
# ReconcilePendingOrders) - see README.md's verification notes for how this
# was diagnosed on the original dev machine.
BINANCE_WS_BASE_URL=wss://fstream.binance.com

# ---- Trading parameters ----
KLINE_INTERVAL=5m
LEVERAGE_DEFAULT=3
# Fixed margin committed per order. Notional position value = MARGIN_USD *
# leverage (whatever the current leverage setting is, adjustable 1-25x in
# the dashboard) - there is deliberately no separate absolute notional
# ceiling, so raising leverage does proportionally increase position size.
# This (and LEVERAGE_DEFAULT above) is only the seed value written by the
# first migration - after that, the live value lives in the `settings`
# table and is edited via the dashboard/POST /api/settings, not this file.
MARGIN_USD=5
MARGIN_TYPE=ISOLATED
# Auto-trading is armed the instant the server starts with this true (the
# default) - no separate "arm" step. Flip the kill switch in the dashboard
# (or set this to false) to start paused instead. Even when armed, the
# autotrader never trades off the bare rule signal - it requires a working
# ANTHROPIC_API_KEY to actually place an order (see below).
AUTOTRADE_ENABLED_DEFAULT=true
# Belt-and-suspenders circuit breakers, independent of the rule-transition
# gating: minimum 1 candle interval between auto orders per symbol, and a
# hard daily cap on total auto orders (resets at UTC midnight).
MAX_AUTO_ORDERS_PER_DAY=20
LISTEN_KEY_KEEPALIVE_MINUTES=30
# Hour (0-23, UTC) the daily AI watchlist-selection scheduler fires
# (internal/watchlistai) - picks the day's tradable symbols and replaces the
# watchlist with them. Runs every day, no weekday skip. Requires
# ANTHROPIC_API_KEY below; can also be triggered on demand via
# POST /api/watchlist/ai-refresh.
WATCHLIST_AI_REFRESH_HOUR_UTC=0

# ---- Claude API ----
# Get a key from https://console.anthropic.com if you don't have one.
# Required for auto-trading to ever actually place an order - the
# deterministic rule alone never triggers a trade, only an AI-confirmed
# signal does (see internal/ai, internal/autotrader). Without this set, the
# rest of the dashboard (charts, positions, manual orders) still works.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- AI prompts ----
# System prompts for the two Claude calls (internal/ai.GenerateSignal /
# SelectDailyWatchlist). Multi-line heredoc syntax: KEY<<EOF ... a line that
# is exactly EOF ends it. Editing these tunes the AI's wording/judgment
# without a Go rebuild - the backend restart script (see README.md) reads
# this whole block into one environment variable value. A restart is still
# required to pick up a change (read once at startup, not live-reloaded). If
# either block is removed entirely, internal/config falls back to the
# built-in default (the same text seeded below).
AI_SIGNAL_SYSTEM_PROMPT<<EOF
你是加密貨幣永續合約短線交易訊號審核助手。下方是規則引擎偵測到、機械條件都已符合的候選交易設定，請判斷值不值得真的下單：有疑慮就選HOLD，不要照單全收。entry_hint/stop_loss/take_profit一律填實際價格、禁止填0，風險報酬比至少1.5倍。若有提供上一次訊號或目前持倉，一併納入判斷。務必呼叫emit_trade_signal工具回傳結果。
EOF

AI_WATCHLIST_SYSTEM_PROMPT<<EOF
你是Binance永續合約選幣助手。請從候選清單中選出指定數量、recent_signal_count（近期規則實際偵測到訊號的次數）最高的合約，次要參考24h成交金額與資金費率。只能選清單內的合約，每檔給簡短理由並指出至少一項風險。務必呼叫工具回傳結果。
EOF
